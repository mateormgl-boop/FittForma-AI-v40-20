  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Module-gradient pill for the main action of a section; brand gradient outside sections.",
      "html": "<button class=\"ds-btn-primary\">Crear mi rutina</button>",
      "css": ".ds-btn-primary{font-family:Inter,system-ui,sans-serif;font-weight:700;font-size:15px;min-height:44px;padding:10px 20px;border:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,var(--mod,#2f5fe8),var(--mod-2,#6a4cf2));box-shadow:0 8px 20px -8px var(--mod,#2f5fe8);cursor:pointer;transition:filter .15s,transform .15s}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{transform:scale(.99)}.ds-btn-primary:focus-visible{outline:2px solid var(--mod,#2f5fe8);outline-offset:2px}.ds-btn-primary:disabled{opacity:.55;box-shadow:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outline pill in module ink for the second action.",
      "html": "<button class=\"ds-btn-secondary\">Ver mis 6 insignias</button>",
      "css": ".ds-btn-secondary{font-family:Inter,system-ui,sans-serif;font-weight:700;font-size:15px;min-height:44px;padding:10px 20px;border-radius:999px;background:transparent;color:var(--mod-ink,#2347b8);border:1.5px solid color-mix(in srgb,var(--mod,#2f5fe8) 55%,transparent);cursor:pointer;transition:background .15s}.ds-btn-secondary:hover{background:var(--mod-soft,rgba(47,95,232,.1))}.ds-btn-secondary:focus-visible{outline:2px solid var(--mod,#2f5fe8);outline-offset:2px}"
    },
    {
      "name": "Pill Tabs",
      "kind": "nav",
      "refersTo": "pill-tabs",
      "description": "Subsection switcher: white pill tray, active tab in the module gradient.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab is-active\" role=\"tab\" aria-selected=\"true\">Rutinas</button><button class=\"ds-tab\" role=\"tab\">Ejercicios</button><button class=\"ds-tab\" role=\"tab\">Running</button><button class=\"ds-tab\" role=\"tab\">Planes</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:4px;padding:4px;background:var(--ff-panel,#fff);border:1px solid var(--ff-border,rgba(30,50,100,.11));border-radius:999px;box-shadow:var(--ff-shadow-sm,0 3px 10px rgba(22,40,90,.07));font-family:Inter,system-ui,sans-serif}.ds-tab{min-height:40px;padding:8px 14px;border:0;border-radius:999px;background:transparent;color:var(--text-2,#3b4764);font-weight:700;font-size:13px;cursor:pointer}.ds-tab:hover{color:var(--text,#0d1830)}.ds-tab:focus-visible{outline:2px solid var(--mod,#2f5fe8);outline-offset:1px}.ds-tab.is-active{background:linear-gradient(135deg,var(--mod,#0a68d6),var(--mod-2,#1b54d8));color:#fff;box-shadow:0 6px 16px -8px var(--mod,#0a68d6)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Default container: 20px radius, hairline, soft shadow; nested content goes flat.",
      "html": "<article class=\"ds-card\"><h3>Hábitos de hoy</h3><p>3 de 5 completados</p><div class=\"ds-card-nested\">Me moví o entrené según mi plan</div></article>",
      "css": ".ds-card{font-family:Inter,system-ui,sans-serif;background:var(--ff-panel,#fff);color:var(--text,#0d1830);border:1px solid var(--ff-border,rgba(30,50,100,.11));border-radius:20px;padding:16px;box-shadow:var(--ff-shadow-sm,0 3px 10px rgba(22,40,90,.07));max-width:360px}.ds-card h3{margin:0 0 4px;font-size:17px;font-weight:800;letter-spacing:-.02em}.ds-card p{margin:0 0 12px;font-size:13px;color:var(--text-3,#56627e)}.ds-card-nested{background:var(--ff-panel-2,#eef2f9);border:1px solid var(--ff-border,rgba(30,50,100,.11));border-radius:14px;padding:10px 12px;font-size:15px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Field on the second panel tone with a module-coloured focus outline.",
      "html": "<label class=\"ds-field\"><span>Peso (kg)</span><input class=\"ds-input\" placeholder=\"72,5\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:Inter,system-ui,sans-serif;font-size:13px;color:var(--text-2,#3b4764);max-width:280px}.ds-input{min-height:44px;padding:10px 12px;font:inherit;font-size:16px;background:var(--ff-panel-2,#eef2f9);color:var(--text,#0d1830);border:1px solid var(--ff-border,rgba(30,50,100,.11));border-radius:12px}.ds-input::placeholder{color:var(--text-3,#56627e)}.ds-input:focus-visible{outline:2px solid var(--mod,#2f5fe8);outline-offset:1px;border-color:transparent}"
    },
    {
      "name": "Tag and Chip",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Soft-tint tag in module ink; selected filter chip fills with the module base.",
      "html": "<span class=\"ds-tag\">Pecho</span> <button class=\"ds-chip\">Todos</button> <button class=\"ds-chip is-active\" aria-pressed=\"true\">Favoritos</button>",
      "css": ".ds-tag{display:inline-block;font-family:Inter,system-ui,sans-serif;font-size:11px;font-weight:700;padding:4px 8px;border-radius:999px;background:var(--mod-soft,rgba(10,104,214,.1));color:var(--mod-ink,#0b5cb4)}.ds-chip{font-family:Inter,system-ui,sans-serif;font-size:13px;font-weight:700;min-height:36px;padding:6px 14px;border-radius:999px;border:1px solid var(--ff-border,rgba(30,50,100,.11));background:var(--ff-panel,#fff);color:var(--text-2,#3b4764);cursor:pointer}.ds-chip:hover{border-color:var(--mod,#0a68d6)}.ds-chip:focus-visible{outline:2px solid var(--mod,#0a68d6);outline-offset:1px}.ds-chip.is-active{background:var(--mod,#0a68d6);border-color:var(--mod,#0a68d6);color:#fff}"
    },
    {
      "name": "Section Hero",
      "kind": "custom",
      "refersTo": "section-hero",
      "description": "Signature band at the top of each section: module gradient, white type, translucent outline action.",
      "html": "<section class=\"ds-hero\"><div><h2>Nutrición</h2><p>Comé bien, rendí mejor.</p></div><button class=\"ds-hero-btn\">Registrar comida</button></section>",
      "css": ".ds-hero{position:relative;display:flex;align-items:flex-end;justify-content:space-between;gap:12px;min-height:118px;padding:18px;border-radius:22px;color:#fff;font-family:Inter,system-ui,sans-serif;background:linear-gradient(90deg,rgba(0,0,0,.22),rgba(0,0,0,0) 70%),linear-gradient(135deg,var(--mod,#0a7a50),var(--mod-2,#0c7d63));box-shadow:0 14px 30px -18px var(--mod,#0a7a50)}.ds-hero h2{margin:0 0 4px;font-size:26px;font-weight:800;letter-spacing:-.03em}.ds-hero p{margin:0;font-size:13px}.ds-hero-btn{min-height:40px;padding:8px 16px;border-radius:999px;background:rgba(0,0,0,.22);color:#fff;border:1.5px solid rgba(255,255,255,.55);font:inherit;font-weight:700;font-size:13px;cursor:pointer}.ds-hero-btn:hover{background:rgba(0,0,0,.32)}.ds-hero-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Six-item phone nav; the active item wears its own module ink on a 12% tint.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item is-active\" style=\"--nav-c:#2347c8\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 11l8-7 8 7v9h-5v-6H9v6H4z\"/></svg>Inicio</a><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 12h2M19 12h2M6 8v8M18 8v8M9 12h6\"/></svg>Entrenar</a><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M7 3v8M5 3v5a2 2 0 004 0V3M7 11v10M16 3c-2 0-3 3-3 6s1 4 3 4v8\"/></svg>Nutrición</a><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20V4M4 20h16M7 15l4-4 3 3 5-6\"/></svg>Progreso</a></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;padding:6px;background:color-mix(in srgb,var(--ff-panel,#fff) 94%,transparent);backdrop-filter:blur(14px);border-top:1px solid var(--ff-border,rgba(30,50,100,.11));box-shadow:0 -6px 24px rgba(10,20,50,.08);font-family:Inter,system-ui,sans-serif;max-width:390px}.ds-nav-item{display:flex;flex-direction:column;align-items:center;gap:3px;min-height:58px;justify-content:center;border-radius:14px;color:var(--text-3,#56627e);font-size:11px;font-weight:600;text-decoration:none}.ds-nav-item svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-nav-item:hover{color:var(--text,#0d1830)}.ds-nav-item:focus-visible{outline:2px solid #2f6bff;outline-offset:-2px}.ds-nav-item.is-active{color:var(--nav-c,#2f6bff);background:color-mix(in srgb,var(--nav-c,#2f6bff) 12%,transparent)}"
    },
    {
      "name": "Icon Stat Tile",
      "kind": "custom",
      "refersTo": "card-nested",
      "description": "Weekly indicator: tinted rounded-square line icon beside a label and a bold value.",
      "html": "<div class=\"ds-stat\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3s6 7 6 11a6 6 0 01-12 0c0-4 6-11 6-11z\"/></svg><small>Agua</small><strong>0/6</strong></div>",
      "css": ".ds-stat{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:8px;align-items:center;max-width:180px;padding:10px;border-radius:16px;background:var(--ff-panel-2,#eef2f9);border:1px solid var(--ff-border,rgba(30,50,100,.11));font-family:Inter,system-ui,sans-serif}.ds-stat svg{grid-row:1/3;width:30px;height:30px;padding:6px;border-radius:10px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;color:#0a8fd0;background:rgba(10,143,208,.14)}.ds-stat small{font-size:12px;color:var(--text-3,#56627e)}.ds-stat strong{font-size:17px;font-weight:800;color:var(--text,#0d1830)}"
    }
  ],
  "narrative": {
    "northStar": "One Kit, Seven Colours",
    "overview": "FittForma AI is a phone-first training app whose sections (Inicio, Entrenar, Running, Nutrición, Progreso, Comunidad, Perfil, plus FittAI) each carry their own colour while sharing one component family. The same pill button, pill tab, rounded card and progress bar appear everywhere; only the module colour changes. That refuses the grey dashboard with a single accent: you always know which part of your training you are in by colour, and you never have to relearn a control.\n\nLight is the default theme: a cool blue-white ground with white cards lifted by soft, blue-tinted shadows. Dark is a deep navy world with layered panels, a faint brand glow in the page background and neutral black shadows. Both themes keep identical geometry and component behaviour; only surfaces, ink tints and shadow colour swap. Density is phone-practical: generous rounded containers, 44px controls, short labels, and primary actions within one or two taps.\n\nReal imagery carries the energy where it matters. Workout heroes use real gym photography under a dark navy overlay with white type in both themes, while charts, rings and progress bars take the module colour. Nothing decorates for its own sake: numbers come from logged data, and colour marks place and state.",
    "keyCharacteristics": [
      "One component family; colour is assigned per section through four variables (base, second stop, ink, soft tint).",
      "Pill-shaped actions and tabs; 18–24px rounded cards and heroes.",
      "Module gradient (135deg, base to second stop) on primary actions, active tabs, section heroes and progress fills.",
      "Light default with soft tinted shadows; dark navy alternative with neutral shadows.",
      "Photo heroes under dark overlays with white type, regardless of theme.",
      "Inter, self-hosted, heavy weights (700–800) with tight negative tracking on headings."
    ],
    "rules": [
      {
        "name": "The Four Variables Rule",
        "body": "A section's colour is expressed only through `--mod`, `--mod-2`, `--mod-ink` and `--mod-soft` set on its `#view-*` container. Components read those variables; they never hard-code a section hue.",
        "section": "colors"
      },
      {
        "name": "The White On Colour Rule",
        "body": "Anything drawn on a module gradient, a photo hero or the navy greeting band (heading, body, status, button) is white, in both themes. Buttons inside a coloured hero become translucent outline pills.",
        "section": "colors"
      },
      {
        "name": "The Ink Not Base Rule",
        "body": "Coloured text on the page ground uses the module ink for the current theme; the saturated base is reserved for fills behind white text.",
        "section": "colors"
      },
      {
        "name": "The Weight Carries Rank Rule",
        "body": "Hierarchy is weight plus size: 800 for headings and numbers, 700 for actions and labels, 400–600 for reading text. Headings always take negative tracking (-0.02em to -0.03em).",
        "section": "typography"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "No UI text below 11px in either theme.",
        "section": "typography"
      },
      {
        "name": "The Nested Goes Flat Rule",
        "body": "A card inside a card loses its shadow and takes the second panel tone. Rows inside a group (meals, recent activity) are separated by hairlines, never boxed again.",
        "section": "elevation"
      },
      {
        "name": "The No Coloured Glow In The Dark Rule",
        "body": "In dark theme, depth comes from neutral black shadows; module-tinted halos exist only in light theme.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set a section's colour only through its four module variables on the `#view-*` container and let components inherit.",
      "**Do** use the 135deg module gradient for every primary action, active pill tab, section hero and progress fill.",
      "**Do** keep text on any coloured or photo surface white, in both themes.",
      "**Do** use the module ink (not the base) for coloured text on the page ground, with the theme's own ink value.",
      "**Do** flatten nested surfaces: second panel tone, no shadow, hairline separators for rows.",
      "**Do** keep controls at 40–44px minimum height and UI text at 11px or larger.",
      "**Do** put real gym photos under a dark navy overlay with white type when a hero needs imagery.",
      "**Do** use stroked line icons (1.8–1.9px) inside rounded-square tinted chips."
    ],
    "donts": [
      "**Don't** hard-code a section hue inside a component; read `--mod`, `--mod-2`, `--mod-ink`, `--mod-soft`.",
      "**Don't** use coloured glows for depth in dark theme; use neutral black shadows.",
      "**Don't** box rows inside a card as cards again.",
      "**Don't** use square or small-radius buttons; actions are pills.",
      "**Don't** introduce a second typeface; Inter carries every role.",
      "**Don't** use text glyphs or emoji as icons; use inline SVG line icons."
    ]
  }
}